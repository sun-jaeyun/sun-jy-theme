		"editor.findMatchBorder": "{{accentTeal}}",
		"editor.findMatchHighlightBorder": "{{white|50}}",
		"tab.activeBorder": "{{accentTeal}}",
		"tab.activeModifiedBorder": "{{textMuted}}",
		"tab.unfocusedActiveBorder": "{{textDisabled}}",
		"tab.activeForeground": "{{white}}",
		"tab.inactiveForeground": "{{textMuted}}",
		"tab.inactiveBackground": "{{bg}}",
		"tab.unfocusedActiveForeground": "{{textPrimary}}",
		"tab.border": "{{bg}}",
		"statusBar.noFolderBackground": "{{bg}}",
		"statusBar.border": "{{black|60}}",
		"statusBar.background": "{{bgDeep}}",
		"statusBar.foreground": "{{neutral}}",
		"statusBar.debuggingBackground": "{{magenta}}",
		"statusBar.debuggingForeground": "{{white}}",
		"statusBarItem.hoverBackground": "{{textDisabled|20}}",
		"statusBarItem.remoteForeground": "{{black}}",
		"statusBarItem.remoteBackground": "{{accentTeal}}",
		"activityBar.background": "{{bgDeep}}",
		"activityBar.border": "{{black|60}}",
		"activityBar.foreground": "{{textPrimary}}",
		"activityBarBadge.background": "{{accentTeal}}",
		"activityBarBadge.foreground": "{{black}}",
		"titleBar.activeBackground": "{{bgDeep}}",
		"titleBar.activeForeground": "{{textPrimary}}",
		"titleBar.inactiveBackground": "{{bgDeep}}",
		"titleBar.inactiveForeground": "{{textMuted}}",
		"titleBar.border": "{{black|60}}",
		"sideBar.background": "{{bgDeep}}",
		"sideBar.foreground": "{{textMuted}}",
		"sideBar.border": "{{black|60}}",
		"sideBarTitle.foreground": "{{textPrimary}}",
		"sideBarSectionHeader.background": "{{bgDeep}}",
		"sideBarSectionHeader.border": "{{black|60}}",
		"input.background": "{{bgInput}}",
		"input.foreground": "{{textPrimary}}",
		"input.placeholderForeground": "{{textPrimary|60}}",
		"input.border": "{{white|10}}",
